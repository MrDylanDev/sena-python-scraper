# SENA learner portal credentials.
# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit it.

# --- SENA portal (scraper) ---
SENA_USUARIO=
SENA_PASSWORD=
SENA_TIPO_DOCUMENTO=CC

# --- Gmail SMTP (mailer) ---
# GMAIL_USER is the email account that will SEND the applications.
# GMAIL_APP_PASSWORD is the 16-char App Password from
#   https://myaccount.google.com/apppasswords
# (NOT your normal Gmail password — that won't work with 2FA enabled.)
GMAIL_USER=
GMAIL_APP_PASSWORD=
